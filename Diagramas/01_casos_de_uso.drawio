hogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="660"/><mxPoint x="15" y="135"/></Array></mxGeometry></mxCell><mxCell id="c66" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="920"/><mxPoint x="15" y="135"/></Array></mxGeometry></mxCell><mxCell id="c67" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="70"/><mxPoint x="100" y="70"/></Array></mxGeometry></mxCell><mxCell id="c68" value="" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="844"/><mxPoint x="1440" y="370"/></Array></mxGeometry></mxCell><mxCell id="c69" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="«extend»&lt;br&gt;[pagamento aprovado]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="c22" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="c16" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="640"/><mxPoint x="980" y="640"/></Array></mxGeometry></mxCell><mxCell id="c72" value="«extend»&lt;br&gt;(se aprovado e com consentimento)" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="c23" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="1010" width="300" height="30" as="geometry"/></mxCell><mxCell id="c75" value="Núcleo (Fluxo A)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1300" y="1040" width="140" height="36" as="geometry"/></mxCell><mxCell id="c76" value="Complementar" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1450" y="1040" width="140" height="36" as="geometry"/></mxCell><mxCell id="c77" value="Planejado (só documentado)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300" y="1085" width="290" height="36" as="geometry"/></mxCell><mxCell id="c78" value="Obs.:&lt;br&gt;- Usuário é um ator genérico: Cliente, Atendente, Cozinha e Gerente herdam dele, então todos fazem login (UC02).&lt;br&gt;- Tirando UC01, UC03 e UC11 (públicos), todos os casos de uso precisam de login (token JWT).&lt;br&gt;- O Administrador herda tudo que o Gerente faz.&lt;br&gt;- UC09 (baixar estoque) só vale se o pagamento for aprovado. Se for recusado ou falhar, a baixa é desfeita (rollback).&lt;br&gt;- Pagamento desacoplado: a API só pede, recebe aprovado/recusado e registra (UC20 é o mock).&lt;br&gt;- UC06 usa Idempotency-Key para não cobrar duas vezes." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="1100" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>