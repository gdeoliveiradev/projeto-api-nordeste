;endFill=0;startFill=0;endSize=10;startSize=10;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c3" target="c79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c101" value="acumula" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endFill=0;startFill=0;endSize=10;startSize=10;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c86"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="184"/><mxPoint x="20" y="840"/></Array></mxGeometry></mxCell><mxCell id="c102" value="executa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endFill=0;startFill=0;endSize=10;startSize=10;fontSize=11;startArrow=ERzeroToOne;endArrow=ERzeroToMany;exitX=1;exitY=0.9;entryX=0.5;entryY=1;" edge="1" parent="1" source="c3" target="c71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="392" y="283"/><mxPoint x="392" y="1015"/><mxPoint x="970" y="1015"/></Array></mxGeometry></mxCell><mxCell id="c103" value="faz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endFill=0;startFill=0;endSize=10;startSize=10;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=1;exitY=0.75;entryX=0;entryY=0.25;" edge="1" parent="1" source="c3" target="c35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="404" y="246"/><mxPoint x="404" y="462"/></Array></mxGeometry></mxCell><mxCell id="c104" value="tem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endFill=0;startFill=0;endSize=10;startSize=10;fontSize=11;startArrow=ERmandOne;endArrow=ERmany;exitX=0.8;exitY=0;entryX=0.3;entryY=0;" edge="1" parent="1" source="c35" target="c46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="692" y="300"/><mxPoint x="1282" y="300"/></Array></mxGeometry></mxCell><mxCell id="c105" value="&lt;b&gt;Regras e restrições importantes&lt;/b&gt;&lt;br&gt;- canal_pedido é obrigatório (NOT NULL) e só aceita os 5 valores do ENUM.&lt;br&gt;- estoque: uma linha por unidade + produto (UNIQUE) e quantidade nunca negativa (CHECK).&lt;br&gt;- A baixa usa UPDATE ... WHERE quantidade &amp;gt;= x, dentro da transação do pagamento.&lt;br&gt;- pagamento.idempotency_key é UNIQUE: a mesma chave não gera outro pagamento.&lt;br&gt;- Um pedido pode ter várias tentativas de pagamento (ex.: recusado e depois aprovado), mas só uma APROVADO.&lt;br&gt;- item_pedido guarda o preço do momento da compra (se o preço mudar depois, o pedido não muda).&lt;br&gt;- Cardápio da unidade = produtos com ativo = true e quantidade &amp;gt; 0 no estoque daquela unidade.&lt;br&gt;- Senha só como hash (bcrypt). O log não guarda dado pessoal, só ids.&lt;br&gt;- movimentacao_estoque.pedido_id e movimento_pontos.pedido_id ligam ao pedido (linhas omitidas pra não poluir)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="600" width="440" height="300" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b&gt;Planejado (não vai pro banco agora)&lt;/b&gt;&lt;br&gt;- promocao / campanha&lt;br&gt;- produto.data_inicio / data_fim (sazonal por datas)&lt;br&gt;- reserva de estoque&lt;br&gt;- unidades só entram pelo seed (sem POST /unidades)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="920" width="440" height="110" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;Legenda:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="80" height="30" as="geometry"/></mxCell><mxCell id="c108" value="Núcleo (Fluxo A)" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="1040" width="140" height="30" as="geometry"/></mxCell><mxCell id="c109" value="Complementar (fidelidade)" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="1040" width="180" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>