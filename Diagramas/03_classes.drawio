" connectable="0" parent="c76"><mxGeometry x="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c79" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c29" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="770"/><mxPoint x="20" y="160"/></Array></mxGeometry></mxCell><mxCell id="c80" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;" vertex="1" connectable="0" parent="c79"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c81" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;" vertex="1" connectable="0" parent="c79"><mxGeometry x="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c82" value="«usa»" style="endArrow=open;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" parent="1" source="c35" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c83" value="" style="endArrow=block;endFill=0;endSize=14;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c41" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c84" value="«cria»" style="endArrow=open;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.3;" edge="1" parent="1" source="c35" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c85" value="«registra»" style="endArrow=open;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;" edge="1" parent="1" source="c35" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c86" value="&lt;b&gt;Obs.:&lt;/b&gt;&lt;br&gt;- Camadas: classes azuis = domínio; PagamentoService = aplicação; GatewayPagamentoMock = infraestrutura.&lt;br&gt;- O serviço depende da &lt;i&gt;interface&lt;/i&gt; GatewayPagamento. Pra trocar o mock por um gateway real, é só criar outra classe que implemente a interface.&lt;br&gt;- A regra da ordem dos status fica em Pedido.mudarStatus(): AGUARDANDO_PAGAMENTO -&gt; PAGO -&gt; EM_PREPARO -&gt; PRONTO -&gt; ENTREGUE (CANCELADO a partir de qualquer um antes de ENTREGUE). Pulo de status gera erro 409.&lt;br&gt;- Produto.ativar()/desativar() é a ativação manual. Controle sazonal por datas é planejado.&lt;br&gt;- LogAuditoria e Pedido ficam ligados a Usuario pelo atributo (linhas omitidas pra não poluir)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="960" width="420" height="230" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;Legenda:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="80" height="30" as="geometry"/></mxCell><mxCell id="c88" value="Núcleo (Fluxo A)" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="1300" width="140" height="30" as="geometry"/></mxCell><mxCell id="c89" value="Complementar (fidelidade)" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="1300" width="180" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>